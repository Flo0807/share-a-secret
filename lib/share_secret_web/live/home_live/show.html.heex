<Layouts.app>
  <h1 class="text-3xl">
    {gettext("Reveal a secret")}
  </h1>

  <.alert :if={@error} id="invalid-link-error" class="mt-4" type={:error} text={@error} />

  <div :if={!@error && @mode == :client} class="mt-4">
    <.alert
      type={:info}
      text={
        gettext(
          "Once you have revealed the secret, you will no longer be able to access it using this URL."
        )
      }
    />

    <div
      id="reveal-secret-root"
      class="mt-6"
      phx-hook="SecretReveal"
      phx-update="ignore"
      data-secret-id={@id}
    >
      <button
        id="reveal-secret-button"
        class="btn btn-primary"
        type="button"
        data-secret-reveal-target="button"
        disabled
      >
        {gettext("Reveal")}
        <span
          id="reveal-secret-loading"
          class="loading loading-spinner"
          data-secret-reveal-target="loading"
          hidden
        ></span>
      </button>

      <.alert
        id="reveal-secret-error"
        class="mt-4"
        type={:error}
        text={
          gettext(
            "Unable to reveal this secret. The link may be invalid, expired, or already used."
          )
        }
        data-secret-reveal-target="error"
        hidden
      />

      <div id="secret-output" data-secret-reveal-target="output" hidden>
        <textarea
          id="secret-text"
          phx-hook="DynamicTextArea"
          class="textarea textarea-bordered h-[100px] w-full"
          data-min-height={100}
          data-secret-reveal-target="textarea"
          readonly
        ></textarea>
        <.copy_to_clipboard
          id="copy-secret"
          class="btn btn-neutral mt-6"
          aria-label={gettext("Copy secret")}
          clipboard_element_id="secret-text"
        >
          <:active>
            <div class="text-success flex items-center space-x-2">
              <p>{gettext("Copy secret")}</p>
              <.icon name="hero-clipboard-document-check" />
            </div>
          </:active>
          <:idle>
            <div class="flex items-center space-x-2">
              <p>{gettext("Copy secret")}</p>
              <.icon name="hero-clipboard" />
            </div>
          </:idle>
        </.copy_to_clipboard>
      </div>

      <noscript>
        <.alert
          class="mt-4"
          type={:error}
          text={gettext("JavaScript and Web Crypto are required to decrypt this secret.")}
        />
      </noscript>
    </div>
  </div>

  <div :if={!@error && @mode == :legacy} class="mt-4">
    <.alert
      type={:info}
      text={
        gettext(
          "Once you have revealed the secret, you will no longer be able to access it using this URL."
        )
      }
    />

    <div class="mt-6">
      <textarea
        :if={@secret}
        id="secret-text"
        phx-hook="DynamicTextArea"
        class="textarea textarea-bordered h-[100px] w-full"
        data-min-height={100}
        readonly
      ><%= @secret %></textarea>
      <.copy_to_clipboard
        :if={@secret}
        id="copy-secret"
        class="btn btn-neutral mt-6"
        aria-label={gettext("Copy secret")}
        clipboard_element_id="secret-text"
      >
        <:active>
          <div class="text-success flex items-center space-x-2">
            <p>{gettext("Copy secret")}</p>
            <.icon name="hero-clipboard-document-check" />
          </div>
        </:active>
        <:idle>
          <div class="flex items-center space-x-2">
            <p>{gettext("Copy secret")}</p>
            <.icon name="hero-clipboard" />
          </div>
        </:idle>
      </.copy_to_clipboard>

      <button
        :if={!@secret}
        id="reveal-legacy-secret-button"
        class="btn btn-primary"
        type="button"
        phx-click="reveal-legacy-secret"
      >
        {gettext("Reveal")}
      </button>
    </div>
  </div>
</Layouts.app>
