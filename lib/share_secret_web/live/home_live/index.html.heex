<Layouts.app>
  <div id="create-secret-root" phx-hook="SecretCreate" phx-update="ignore">
    <.form
      for={@form}
      id="create-secret-form"
      class="flex flex-col gap-y-4"
      data-secret-create-target="form"
    >
      <label for="secret-input">
        <h1 class="mb-4 text-3xl">{gettext("Enter your secret")}</h1>
      </label>

      <.input
        id="secret-input"
        type="textarea"
        field={@form[:secret]}
        placeholder={gettext("Secret...")}
        maxlength="65536"
        required
        disabled
        data-secret-create-target="secret"
      />

      <.input
        id="link-count"
        class="input max-w-20 block w-full"
        type="number"
        field={@form[:link_count]}
        label={gettext("Number of links")}
        min="1"
        max={@max_links}
        required
        disabled
        data-secret-create-target="link-count"
      />

      <.input
        id="expiration"
        class="select max-w-32 block w-full"
        type="select"
        field={@form[:expiration]}
        label={gettext("Expiration")}
        options={@expiration_options}
        value={@expiration_default}
        required
        disabled
        data-secret-create-target="expiration"
      />

      <button
        id="create-secret-submit"
        class="btn btn-primary mt-4 self-start"
        type="button"
        disabled
        data-secret-create-target="submit"
      >
        {gettext("Generate links")}
        <span
          id="create-secret-loading"
          class="loading loading-spinner"
          data-secret-create-target="loading"
          hidden
        ></span>
      </button>

      <.alert
        id="create-secret-error"
        class="mt-4"
        type={:error}
        text={gettext("Unable to create the secret securely. Please try again.")}
        data-secret-create-target="error"
        hidden
      />

      <noscript>
        <.alert
          class="mt-4"
          type={:error}
          text={
            gettext("JavaScript and Web Crypto are required to encrypt secrets in your browser.")
          }
        />
      </noscript>
    </.form>

    <section id="generated-links-panel" data-secret-create-target="results" hidden>
      <h1 class="text-3xl">{gettext("Your links")}</h1>

      <.alert
        class="mt-4"
        type={:warning}
        text={
          gettext(
            "The following links will reveal your secret. Keep the links as confidential as possible. Each link is valid only once!"
          )
        }
      />

      <div
        :for={index <- 0..(@max_links - 1)}
        id={"link-row-#{index}"}
        class="mt-6"
        data-secret-create-link-row={index}
        hidden
      >
        <.secret_link id={"link-#{index}"} link="" data-secret-create-link={index} />
      </div>
    </section>
  </div>
</Layouts.app>
